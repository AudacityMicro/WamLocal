{
  "name": "wam-local",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Offline waterjet design and CAM workbench",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && npm run build:mcp && npm run build:desktop",
    "build:desktop": "esbuild src/desktop/material-library.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-electron/library.cjs",
    "test": "vitest run",
    "mcp": "tsx src/mcp/server.ts",
    "package": "npm run build && electron-builder --win nsis portable --publish never",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-mcp/server.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "postinstall": "install-electron",
    "verify:electron": "node scripts/verify-electron.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "clipper-lib": "^6.4.2",
    "dxf-parser": "^1.1.2",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.468.0",
    "maxrects-packer": "^3.0.0",
    "paper": "^0.12.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.audacitymicro.wamlocal",
    "productName": "Wam Local",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "dist-mcp/**/*",
      "dist-electron/**/*",
      "licenses/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AudacityMicro",
        "repo": "WamLocal",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Wam Local",
      "artifactName": "Wam-Local-Setup-${version}-${arch}.${ext}"
    }
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "author": "AudacityMicro"
}
